APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: SQLite (arquivo database/database.sqlite; crie com
# `touch database/database.sqlite` e rode `php artisan migrate`).
DB_CONNECTION=sqlite

# Produção: Postgres no Neon, configurado no painel do Render (ver render.yaml).
# Para testar contra um Postgres, troque as linhas acima por algo assim
# (valores fictícios — nunca coloque credenciais reais neste arquivo):
# DB_CONNECTION=pgsql
# DB_URL=postgresql://USUARIO:SENHA@HOST.neon.tech/BANCO?sslmode=require

# Sessão em cookie, cache em arquivo e fila síncrona, igual à produção:
# visitas comuns não acessam o banco (regra D9) e e-mails saem na hora.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=larissavarquiterura@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="larissavarquiterura@gmail.com"
MAIL_FROM_NAME="LV Arquitetura"
MAIL_CONTACT_TO=larissavarquiterura@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"

# Temporário: marcadores "[texto pendente]" no resultado do quiz (só local)
QUIZ_CONTENT_PLACEHOLDERS=false
